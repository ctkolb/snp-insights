#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Fast pre-commit gate: staged guard + secret scan of staged files.
# Install once per clone:  git config core.hooksPath hooks
set -eu
root="$(git rev-parse --show-toplevel)"
cd "$root"

python3 scripts/guard.py --staged

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
else
    echo "pre-commit: gitleaks not installed — skipping; CI secret scan is the backstop." >&2
fi
